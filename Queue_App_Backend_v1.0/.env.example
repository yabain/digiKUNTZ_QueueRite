#
#  Copie ce fichier en `.env` puis renseigne tes valeurs.
#  Ne JAMAIS committer le vrai `.env` (contient des secrets).
#
#  NB : les scripts de deploiement (deploy-backend-*) generent automatiquement
#  un .env coherent (CORS_ORIGINS=*) : ce fichier sert de reference.
#
NODE_ENV=production
PORT=3000

# URI Mongo (replica set exigé par la config). Renseigne user/pass reels.
MONGODB_URI=mongodb://<USER>:<PASSWORD>@127.0.0.1:27017/queue_app?replicaSet=rs0&authSource=queue_app

# CORS : "*" autorise toutes les origines (acces depuis le reseau).
CORS_ORIGINS=*

MEDIA_ROOT=./media
SESSION_TTL_HOURS=24
LOG_LEVEL=info

# Bootstrap/admin par defaut (ne pas utiliser en prod).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me